# העתק את הקובץ הזה ל-.env ומלא את הערך האמיתי.
# .env מוחרג ב-.gitignore ולעולם לא עולה לגיט.

# OpenAI — משמש את scripts/gen-image.ps1 ואת סוכן ה-creative.
# המודל נעול על gpt-image-2.
# הערך האמיתי מתחיל ב-sk-. ה-placeholder כאן בכוונה לא —
# בודק הסודות שב-pre-commit חוסם כל מחרוזת שנראית כמו מפתח, גם דוגמה.
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY
