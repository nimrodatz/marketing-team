# ─── סודות: אסור שיעלו ל-GitHub ────────────────────────────
# משתני סביבה
.env
.env.*
!.env.example
!.env.sample

# מפתחות, תעודות, אישורים
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
*.crt
*.cer

# קבצי אישורים נפוצים של שירותים
credentials
credentials.json
service-account*.json
gha-creds-*.json
.netrc
.npmrc
.pypirc
secrets.json
secrets.yaml
secrets.yml
*.secret
*secrets*.env

# ספריות סודות
.secrets/
secrets/

# ─── תלויות ובנייה ─────────────────────────────────────────
node_modules/
dist/
build/
.venv/
venv/
__pycache__/
*.pyc
npm-debug.log*
yarn-error.log*

# ─── מערכת הפעלה ועורכים ───────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp

# ─── אובסידיאן ─────────────────────────────────────────────
# state של החלון, משתנה בכל פתיחה — שאר הקונפיג כן נשמר בגיט
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json
.trash/

# ─── שטח העבודה הפרטי של הקריאייטיב ────────────────────────
# creative/ הוא scratch space ולא תוצר (ראה CLAUDE.md).
# תמונות ניסוי שם הן בינאריות, כבדות, ולא נדחסות בין גרסאות —
# הפרומפט שיצר אותן כן נשמר, וגם התוצרים המאושרים ב-output/creatives/.
creative/*.png
creative/*.jpg
creative/*.jpeg
creative/*.webp
creative/reference/*.png
creative/reference/*.jpg
creative/reference/*.jpeg
creative/reference/*.webp

# ─── שטח העבודה הפרטי של סוכן דפי הנחיתה ───────────────────
# landing/ הוא scratch space ולא תוצר (ראה CLAUDE.md), ולכן ניסויים
# ויזואליים בשורש שלו לא נכנסים להיסטוריה — אותו נימוק כמו creative/.
# שים לב: landing/reference/ **כן נשמר במעקב** ואינו מוחרג כאן.
# הוא חומר מקור שהמשתמש מעלה, לא ניסוי שהמכונה ייצרה — קרוב יותר
# ל-references/ מאשר ל-creative/, ואין לו מקור אחר לשחזור ממנו.
landing/*.png
landing/*.jpg
landing/*.jpeg
landing/*.webp

# תיקיית ברירת המחדל של scripts/extract-visual-identity.ps1 — HTML ו-CSS
# גולמיים שנמשכו מהאתר החי. חומר גלם לקריאה, לא תוצר.
.visual-extract/
